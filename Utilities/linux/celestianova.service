[Unit]
Description=Celestia Nova service runtime
Documentation=file:///opt/celestianova/share/doc/celestianova/LINUX_SERVICE_MODE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=celestianova
Group=celestianova
WorkingDirectory=/opt/celestianova
Environment=CELESTIA_RUNTIME_ROOT=/var/lib/celestianova/content
Environment=CELESTIA_STATUS_API_ENABLED=1
EnvironmentFile=-/etc/celestianova/runtime.env
# Encrypted credential files placed in /etc/celestianova/credentials are
# decrypted by systemd into a private, tmpfs-backed directory for KeyForge.
LoadCredentialEncrypted=keyforge:/etc/celestianova/credentials
ExecStart=/opt/celestianova/bin/CelestiaNova --service-mode --status-file /var/lib/celestianova/status/service-status.json --status-interval-seconds 15
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
StateDirectory=celestianova
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# Celestia's current logger writes its runtime file below Content/Logs.  Keep
# the package immutable otherwise and permit only this dedicated log directory
# plus the StateDirectory used by service-mode status snapshots.
ReadWritePaths=/var/lib/celestianova /opt/celestianova/Content/Logs

[Install]
WantedBy=multi-user.target
