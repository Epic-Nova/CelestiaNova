{
  "$schema": "../../Extensions/Core/ContentForge/Content/Schemas/ContentPack.schema.json",
  "id": "auth-api",
  "name": "Auth API",
  "version": "0.1.0",
  "framework": "laravel",
  "source": {
    "type": "git",
    "repository": "https://github.com/Epic-Nova/Auth-API.git",
    "ref": "master",
    "allowedHosts": ["github.com"]
  },
  "deployment": {
    "orchestrator": "laravelorchestrator",
    "profile": "minimal",
    "composeFile": "compose.yaml",
    "primaryService": "laravel.test",
    "healthEndpoint": "/api/health"
  },
  "configuration": {
    "defaultDepth": "minimal",
    "supportedDepths": ["auto", "minimal", "normal", "advanced"]
  },
  "localDevelopment": {
    "environmentFile": "../../Auth-API/.env",
    "base": "application-root"
  },
  "runtimeEnvironment": {
    "targetId": "local-service",
    "publicValues": {
      "APP_ENV": "production",
      "APP_DEBUG": "false",
      "APP_PORT": "8081",
      "APP_URL": "http://127.0.0.1:8081",
      "WWWUSER": "1000",
      "WWWGROUP": "1000",
      "DB_CONNECTION": "mysql",
      "DB_HOST": "mariadb",
      "DB_PORT": "3306",
      "DB_DATABASE": "auth_api",
      "DB_USERNAME": "sail"
    },
    "secretReferences": {
      "APP_KEY": "keyforge://content/auth-api/app-key",
      "DB_PASSWORD": "keyforge://content/auth-api/db-password"
    }
  },
  "remoteDeployment": {
    "targetManifest": "../RemoteTargets/VirtualBoxUbuntu.json",
    "releaseRoot": "/opt/celestia/releases",
    "requiresNovaId": true
  },
  "novaIdDeviceFlow": {
    "deviceAuthorizeUrl": "http://localhost:8000/api/v1/oauth/device-authorize",
    "deviceApproveUrl": "http://localhost:8000/api/v1/oauth/device-approve",
    "deviceTokenUrl": "http://localhost:8000/api/v1/oauth/device-token",
    "oauthApplication": {
      "applicationId": "celestianova-laravel-orchestrator",
      "authorizationServerId": "auth-api-local",
      "scopes": ["deployment.remote.control"],
      "audiences": ["celestianova"],
      "accessTokenTtlSeconds": 600
    }
  }
}
