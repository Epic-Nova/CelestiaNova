{
  "id": "contentforge",
  "name": "ContentForge",
  "file": "libContentForge.so",
  "version": "0.1.0",
  "autostart": true,
  "startupDelayMs": 170,
  "description": "Content pack and extension asset lifecycle core.",
  "longDescription": "ContentForge manages extension-delivered scripts, templates, and content packs with version-aware fetch, validation, and local materialization hooks.",
  "dependencies": [
    "keyforge",
    "syncforge",
    "gitagent"
  ],
  "publicIncludePaths": [
    "Source"
  ],
  "targetName": "ContentForge",
  "projectName": "ContentForge",
  "outputName": "ContentForge",
  "linkNovaCore": true,
  "canvas": {
    "requirements": {
      "definitions": [
        {
          "key": "contentforge.local.content",
          "title": "Local ContentForge Content",
          "inputType": "Dropdown",
          "resolveMode": "ValueList",
          "strategy": "ContentQuery",
          "requestAction": "contentforge.local.content.list",
          "responseCollectionPath": "items",
          "responseLabelPath": "label",
          "responseValuePath": "value",
          "requestStructName": "CoreRequirementResolveRequest",
          "outputStructName": "CoreRequirementResolveResult"
        }
      ],
      "resolver": {
        "supportedKeys": [
          "contentforge.local.content"
        ],
        "resolverApi": {
          "typedMethod": "ResolveLocalContentRequirement",
          "cAbiBridge": {
            "export": "ContentForge_ResolveRequirement",
            "requestPointer": "CoreRequirementResolveRequest*",
            "resultPointer": "CoreRequirementResolveResult*"
          }
        }
      }
    }
  },
  "optional": {
    "contentPacks": [
      "ContentPackRuntime"
    ],
    "healthEndpoints": [
      "/api/v1/health/contentforge"
    ],
    "contentRoots": [
      "Content"
    ],
    "telemetryStreams": [
      "contentforge.fetch.count",
      "contentforge.pack.count"
    ],
    "grafanaDashboards": [
      "grafana://celestianova/contentforge-delivery"
    ],
    "serviceCapabilities": [
      "content.fetch",
      "content.install",
      "content.list"
    ]
  }
}
