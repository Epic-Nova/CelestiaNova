{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "celestianova.content-action.v1",
  "title": "Celestia Nova Extension Content Action",
  "type": "object",
  "required": ["id", "ownerExtensionId", "execution", "inputSchema"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "ownerExtensionId": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "execution": { "enum": ["render-only", "orchestrator-job"] },
    "requiresConfirmation": { "type": "boolean", "default": false },
    "inputSchema": { "type": "string", "minLength": 1 },
    "templates": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
