{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "celestianova.content-pack.v1",
  "title": "Celestia Nova Content Pack",
  "type": "object",
  "required": ["id", "name", "version", "source", "framework", "deployment"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "framework": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "oneOf": [
        {
          "required": ["type", "path"],
          "properties": {
            "type": { "const": "local-path" },
            "path": { "type": "string", "minLength": 1 },
            "base": { "enum": ["application-root", "manifest-directory"] }
          },
          "additionalProperties": false
        },
        {
          "required": ["type", "repository", "ref", "allowedHosts"],
          "properties": {
            "type": { "const": "git" },
            "repository": { "type": "string", "pattern": "^https://[A-Za-z0-9._/-]+$" },
            "ref": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
            "allowedHosts": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$" },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "deployment": {
      "type": "object",
      "required": ["orchestrator", "composeFile", "primaryService"],
      "properties": {
        "orchestrator": { "type": "string", "minLength": 1 },
        "composeFile": { "type": "string", "minLength": 1 },
        "primaryService": { "type": "string", "minLength": 1 },
        "healthEndpoint": { "type": "string" }
      },
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "properties": {
        "defaultDepth": { "enum": ["auto", "minimal", "normal", "advanced"] },
        "supportedDepths": {
          "type": "array",
          "items": { "enum": ["auto", "minimal", "normal", "advanced"] },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "localDevelopment": {
      "type": "object",
      "description": "Explicit developer-machine bridge. Never place secret values in this manifest.",
      "properties": {
        "environmentFile": { "type": "string", "minLength": 1 },
        "base": { "enum": ["application-root", "manifest-directory"] }
      },
      "additionalProperties": false
    },
    "runtimeEnvironment": {
      "description": "Runtime environment contract. Secret values are always KeyForge references and never content-pack literals.",
      "type": "object",
      "required": ["targetId", "secretReferences"],
      "properties": {
        "targetId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$" },
        "publicValues": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
          "additionalProperties": { "type": "string", "pattern": "^[^\\r\\n\\u0000]*$" }
        },
        "secretReferences": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
          "additionalProperties": { "type": "string", "pattern": "^keyforge://[A-Za-z0-9._/-]+$" }
        }
      },
      "additionalProperties": false
    },
    "remoteDeployment": {
      "description": "Non-secret remote staging target owned by the content pack. Credentials remain KeyForge references only.",
      "type": "object",
      "required": ["targetManifest", "releaseRoot"],
      "properties": {
        "targetManifest": { "type": "string", "minLength": 1 },
        "releaseRoot": { "type": "string", "pattern": "^/[A-Za-z0-9._/-]+$" },
        "requiresAegisSession": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "aegisLogin": {
      "description": "Non-secret OAuth device flow declaration. KeyForge must provision and materialize the client credentials; Celestia retains an issued access token in memory only.",
      "type": "object",
      "required": ["deviceAuthorizeUrl", "deviceApproveUrl", "deviceTokenUrl", "oauthApplication"],
      "properties": {
        "deviceAuthorizeUrl": { "type": "string", "minLength": 1, "pattern": "^https?://" },
        "deviceApproveUrl": { "type": "string", "minLength": 1, "pattern": "^https?://" },
        "deviceTokenUrl": { "type": "string", "minLength": 1, "pattern": "^https?://" },
        "oauthApplication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicationId", "authorizationServerId", "scopes", "audiences"],
          "properties": {
            "applicationId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$" },
            "authorizationServerId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$" },
            "scopes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "audiences": { "type": "array", "items": { "type": "string" } },
            "accessTokenTtlSeconds": { "type": "integer", "minimum": 60, "maximum": 3600, "default": 600 }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
