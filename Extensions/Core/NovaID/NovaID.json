{
  "id": "novaid",
  "name": "NovaID",
  "file": "libNovaID.so",
  "version": "0.1.0",
  "autostart": true,
  "startupDelayMs": 90,
  "description": "Identity bridge extension for OAuth2, 2FA confirmation, and secure token exchange.",
  "longDescription": "NovaID provides the reusable identity module for Celestia Nova, including OAuth2 scope handling, explicit high-risk consent flows, and 2FA-guarded privileged token grants.",
  "dependencies": [
    "aegiscore",
    "keyforge",
    "httpagent"
  ],
  "publicIncludePaths": [
    "Source"
  ],
  "targetName": "NovaID",
  "projectName": "NovaID",
  "outputName": "NovaID",
  "linkNovaCore": true,
  "optional": {
    "contentPacks": [
      "NovaIDAuth"
    ],
    "healthEndpoints": [
      "/api/v1/health/novaid"
    ],
    "contentRoots": [
      "Content"
    ],
    "telemetryStreams": [
      "novaid.token.exchange",
      "novaid.2fa.challenge"
    ],
    "grafanaDashboards": [
      "grafana://celestianova/novaid-security"
    ],
    "serviceCapabilities": [
      "auth.oauth2.exchange",
      "auth.session.validate",
      "auth.scope.prompt"
    ]
  }
}
