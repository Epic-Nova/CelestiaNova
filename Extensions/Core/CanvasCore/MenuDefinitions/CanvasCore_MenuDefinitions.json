    {
      "id": "help",
      "title": "Help",
      "subtitle": "Installed extension help participation and endpoint catalog",
      "icon": "HELP",
      "pageRequirements": [
        "help.catalog.endpoints",
        "catalog.extensions"
      ],
      "sections": [
        {
          "id": "help_catalog",
          "title": "Help Sources",
          "description": "Each extension can participate through declared endpoints, capabilities, and content packs.",
          "fields": [
