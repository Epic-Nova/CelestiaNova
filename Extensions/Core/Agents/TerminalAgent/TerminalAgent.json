{
  "id": "terminalagent",
  "name": "TerminalAgent",
  "file": "libTerminalAgent.so",
  "version": "0.1.0",
  "autostart": true,
  "startupDelayMs": 50,
  "description": "Central extension for securely executing and managing OS-level commands.",
  "longDescription": "TerminalAgent provides a secure, centralized interface for other extensions to interact with the underlying host OS shell. It supports synchronous/asynchronous execution, output streaming, and process lifecycle management.",
  "dependencies": [
    "aegiscore"
  ],
  "publicIncludePaths": [
    "Source"
  ],
  "targetName": "TerminalAgent",
  "projectName": "TerminalAgent",
  "outputName": "TerminalAgent",
  "linkNovaCore": true,
  "canvas": {
    "supportsDirectInvocation": true,
    "menuDefinitions": {
      "schema": "canvas.menu.definitions.v1",
      "file": "TerminalAgent_MenuDefinitions.json",
      "ownerExtensionId": "terminalagent"
    },
    "requirements": {
      "resolver": {
        "supportedKeys": [
          "terminal.history"
        ],
        "resolverApi": {
          "cAbiBridge": {
            "export": "TerminalAgent_ResolveRequirement"
          }
        }
      }
    }
  }
}
