{
    "id":  "python3agent",
    "name":  "Python3Agent",
    "file":  "libPython3Agent.so",
    "version":  "0.1.0",
    "autostart":  false,
    "startupDelayMs":  0,
    "description":  "Agent for Python 3 runtime detection, environment setup, and package command handling.",
    "longDescription":  "Python3Agent supplies Python-specific automation support for setup and orchestration flows, including interpreter validation, environment bootstrap helpers, and package management command execution.",
    "dependencies":  [
                         "canvascore",
                         "terminalagent",
                         "packagemanageragent",
                         "nexuscore"
                     ],
    "publicIncludePaths":  [
                               "Source"
                           ],
    "targetName":  "Python3Agent",
    "projectName":  "Python3Agent",
    "outputName":  "Python3Agent",
    "linkNovaCore":  true,
    "canvas": {
        "supportsDirectInvocation": true,
        "menuDefinitions": {
            "schema": "canvas.menu.definitions.v1",
            "file": "Python3Agent_MenuDefinitions.json",
            "ownerExtensionId": "python3agent"
        }
    },
    "optional": {
        "serviceCapabilities": [
            "python.venv.create",
            "python.pip.install",
            "python.script.run",
            "python.version.get"
        ]
    }
