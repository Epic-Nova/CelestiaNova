{
  "$schema": "../../../../../Core/CanvasCore/MenuDefinitions/CanvasMenuDefinitions.schema.json",
  "schema": "canvas.menu.definitions.v1",
  "ownerExtensionId": "laravelorchestrator",
  "menus": [
    {
      "id": "laravel_main",
      "title": "Laravel Orchestrator",
      "subtitle": "Local content deployment management",
      "icon": "ORCHESTRATOR",
      "sections": [
        {
          "id": "content_lifecycle",
          "title": "Laravel Content Lifecycle",
          "description": "Select a ContentForge-managed Laravel pack, then manage its Compose lifecycle.",
          "fields": [
            {
              "id": "contentId",
              "label": "Content Pack",
              "description": "Choose a locally registered Laravel ContentForge pack.",
              "type": "Dropdown",
              "requirementBinding": {
                "key": "contentforge.local.content",
                "source": "Core",
                "resolveMode": "ValueList",
                "allowMultiple": false,
                "strategy": "ContentQuery",
                "requestAction": "contentforge.local.content.list",
                "responseCollectionPath": "items",
                "responseLabelPath": "label",
                "responseValuePath": "value",
                "preferredResolverExtensionIds": [
                  "contentforge"
                ],
                "requestStructName": "CoreRequirementResolveRequest",
                "outputStructName": "CoreRequirementResolveResult",
                "contextBindings": [
                  {
                    "requestKey": "framework",
                    "fallbackValue": "laravel"
                  },
                  {
                    "requestKey": "orchestrator",
                    "fallbackValue": "laravelorchestrator"
                  }
                ]
              },
              "validations": [
                {
                  "kind": "Required",
                  "message": "A ContentForge content pack ID is required."
                }
              ],
              "valueStorage": "RuntimeOnly"
            },
            {
              "id": "contentStatus",
              "label": "Runtime Status",
              "description": "Use Refresh Status to query the Laravel Compose service.",
              "type": "TextLabel",
              "defaultValue": "Runtime Status: Unknown",
              "valueStorage": "RuntimeOnly"
            },
            {
              "id": "contentDetails",
              "label": "Selected Content",
              "description": "Pack metadata is refreshed after a lifecycle or status action.",
              "type": "TextLabel",
              "defaultValue": "Selected Content: Not validated",
              "valueStorage": "RuntimeOnly"
            },
            {
              "id": "contentProgress",
              "label": "Deployment Progress",
              "description": "Live progress reported by the queued Laravel deployment.",
              "type": "ProgressGauge",
              "defaultValue": "0",
              "dataRequirementKey": "core.progress.percent",
              "valueStorage": "RuntimeOnly"
            },
            {
              "id": "startContent",
              "label": "Start Content",
              "description": "Start the selected local Compose stack through DockerOrchestrator.",
              "type": "ActionButton",
              "defaultValue": "laravel.content.start",
              "valueStorage": "RuntimeOnly"
            },
            {
              "id": "stopContent",
              "label": "Stop Content",
              "description": "Stop the selected local Compose services without removing volumes.",
              "type": "ActionButton",
              "defaultValue": "laravel.content.stop",
              "valueStorage": "RuntimeOnly"
            },
            {
              "id": "refreshContent",
              "label": "Refresh Status",
              "description": "Check whether the Laravel application service is running.",
              "type": "ActionButton",
              "defaultValue": "laravel.content.refresh",
              "valueStorage": "RuntimeOnly"
            },
            {
              "id": "openRemoteAndLogin",
              "label": "Aegis Login & Remote VM",
              "description": "Open the remote lifecycle page. Authentication is managed from AegisCore.",
              "type": "ActionButton",
              "defaultValue": "laravel_remote",
              "valueStorage": "RuntimeOnly"
            }
          ]
        }
      ],
      "cancelAction": "menu.back"
    },
    {
      "id": "laravel_remote",
      "title": "Laravel Remote Control",
      "subtitle": "AegisCore-gated remote VM lifecycle",
      "icon": "NETWORK",
      "sections": [
        {
          "id": "aegis_login_notice",
          "title": "AegisCore Login",
          "description": "Identity is owned by AegisCore. Open AegisCore from the extension menu to create or refresh the memory-only authentication session.",
          "fields": [
            {
              "id": "aegisStatus",
              "label": "Authentication",
              "description": "Login actions are intentionally owned by AegisCore, not by the Laravel orchestrator.",
              "type": "TextLabel",
              "defaultValue": "AegisCore session required",
              "valueStorage": "RuntimeOnly"
            }
          ]
        },
        {
          "id": "remote_lifecycle",
          "title": "Remote VM Lifecycle",
          "description": "Uses the selected pack's declarative SSH target. SSH agent authentication and a verified host key are mandatory.",
          "fields": [
            {
              "id": "remoteStatus",
              "label": "Remote Status",
              "description": "Remote actions are queued and never block menu rendering.",
              "type": "TextLabel",
              "defaultValue": "Remote Status: Not queried",
              "valueStorage": "RuntimeOnly"
            },
            {
              "id": "bootstrapRemote",
              "label": "Bootstrap Remote VM",
              "description": "Install and enable Docker using passwordless sudo on the selected VM.",
              "type": "ActionButton",
              "defaultValue": "laravel.remote.bootstrap",
              "valueStorage": "RuntimeOnly"
            },
            {
              "id": "stageRemote",
              "label": "Stage Remote Release",
              "description": "Upload a ContentForge materialized release. Secrets and .env files are excluded.",
              "type": "ActionButton",
              "defaultValue": "laravel.remote.stage",
              "valueStorage": "RuntimeOnly"
            },
            {
              "id": "refreshRemote",
              "label": "Refresh Remote Status",
              "description": "Query the active remote Compose release over verified SSH.",
              "type": "ActionButton",
              "defaultValue": "laravel.remote.refresh",
              "valueStorage": "RuntimeOnly"
            }
          ]
        }
      ],
      "cancelAction": "laravel_main"
    }
  ]
}
