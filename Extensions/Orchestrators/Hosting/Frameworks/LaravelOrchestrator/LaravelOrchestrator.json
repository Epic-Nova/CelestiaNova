{
    "id":  "laravelorchestrator",
    "name":  "LaravelOrchestrator",
    "file":  "libLaravelOrchestrator.so",
    "version":  "0.1.0",
    "autostart":  true,
    "startupDelayMs":  0,
    "description":  "Framework orchestrator for Laravel environment setup, services, and deployment handoff.",
    "longDescription":  "LaravelOrchestrator handles Laravel-specific automation including runtime prerequisites, environment configuration, framework command routing, and containerized deployment preparation.",
    "dependencies":  [
                         "dockerorchestrator",
                         "terminalagent",
                         "phpagent",
                         "composeragent",
                         "nodeagent",
                         "contentforge",
                         "keyforge",
                         "coreorchestrator"
                     ],
    "publicIncludePaths":  [
                               "Source"
                           ],
    "targetName":  "LaravelOrchestrator",
    "projectName":  "LaravelOrchestrator",
    "outputName":  "LaravelOrchestrator",
    "linkNovaCore":  true,
    "canvas": {
        "supportsDirectInvocation": true,
        "menuDefinitions": {
            "schema": "canvas.menu.definitions.v1",
            "file": "MenuDefinitions/LaravelOrchestrator_MenuDefinitions.json",
            "ownerExtensionId": "laravelorchestrator"
        }
    },
    "optional": {
        "contentRoots": [
            "Content"
        ],
        "contentPacks": [
            "laravel.deployment-template.v1"
        ],
        "serviceCapabilities": [
            "laravel.template.render",
            "laravel.deploy.plan",
            "laravel.remote.bootstrap",
            "laravel.remote.stage",
            "laravel.remote.status"
        ]
    }
}
