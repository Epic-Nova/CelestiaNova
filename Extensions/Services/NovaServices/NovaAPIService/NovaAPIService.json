{
  "id": "novaapiservice",
  "name": "NovaAPIService",
  "file": "libNovaAPIService.so",
  "version": "0.1.0",
  "autostart": true,
  "startupDelayMs": 0,
  "description": "Local HTTP transport service exposing platform and daemon status endpoints.",
  "longDescription": "NovaAPIService hosts the loopback HTTP transport for operational endpoints. NexusCore owns normalized daemon-status aggregation, PulseCore telemetry and SignalCore event data.",
  "dependencies": [
    "coreservice",
    "keyforge",
    "aegiscore",
    "httpagent",
    "contentforge",
    "nexuscore",
    "astrascalecore"
  ],
  "publicIncludePaths": [
    "Source"
  ],
  "targetName": "NovaAPIService",
  "projectName": "NovaAPIService",
  "outputName": "NovaAPIService",
  "linkNovaCore": true,
  "optional": {
    "contentRoots": [
      "Content"
    ],
    "contentPacks": [
      "AuthAPI",
      "ServiceOpsAPI",
      "AdminUIPack"
    ],
    "grafanaDashboards": [
      "grafana://celestianova/novaapi-overview"
    ],
    "healthEndpoints": [
      "/api/v1/health",
      "/api/v1/status",
      "/api/v1/progress"
    ],
    "contentEndpoints": [
      "/api/v1/content/novaapiservice",
      "/api/v1/content/novaapiservice/packs"
    ],
    "telemetryStreams": [
      "novaapi.request.count",
      "novaapi.content.resolve.latency"
    ],
    "serviceCapabilities": [
      "api.routes.list",
      "api.content.resolve",
      "api.deploy.surface",
      "api.health"
    ]
  }
}
